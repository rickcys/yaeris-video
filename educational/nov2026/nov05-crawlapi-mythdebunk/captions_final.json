[
  {"id":"cap0","start":0,"duration":2.32,"text":"A scraping API working perfectly"},
  {"id":"cap1","start":2.32,"duration":1.36,"text":"on your first test page"},
  {"id":"cap2","start":3.84,"duration":1.6,"text":"tells you almost nothing about"},
  {"id":"cap3","start":5.44,"duration":1.84,"text":"whether it's actually production ready."},
  {"id":"cap4","start":7.56,"duration":1.76,"text":"There are two fundamentally different"},
  {"id":"cap5","start":9.32,"duration":1.76,"text":"ways a scraper handles a"},
  {"id":"cap6","start":11.08,"duration":1.76,"text":"target site, and the difference"},
  {"id":"cap7","start":12.84,"duration":0.96,"text":"only shows up once that"},
  {"id":"cap8","start":13.8,"duration":1.2,"text":"site fights back."},
  {"id":"cap9","start":15.333,"duration":2.16,"text":"The naive scraper, one fetch"},
  {"id":"cap10","start":17.493,"duration":2.4,"text":"method every time, works fine"},
  {"id":"cap11","start":19.893,"duration":2.0,"text":"on simple static pages."},
  {"id":"cap12","start":21.893,"duration":1.36,"text":"The moment it hits rate"},
  {"id":"cap13","start":23.253,"duration":1.44,"text":"limiting or a page that"},
  {"id":"cap14","start":24.693,"duration":2.24,"text":"needs real JavaScript rendering,"},
  {"id":"cap15","start":26.933,"duration":1.52,"text":"it either gets blocked or"},
  {"id":"cap16","start":28.453,"duration":1.6,"text":"comes back with an empty shell,"},
  {"id":"cap17","start":30.053,"duration":1.36,"text":"no error, just nothing."},
  {"id":"cap18","start":31.725,"duration":2.24,"text":"The escalating scraper tries a"},
  {"id":"cap19","start":33.965,"duration":2.0,"text":"simple direct fetch first and"},
  {"id":"cap20","start":35.965,"duration":2.24,"text":"automatically upgrades to a residential"},
  {"id":"cap21","start":38.205,"duration":2.08,"text":"proxy, then a full headless"},
  {"id":"cap22","start":40.285,"duration":1.52,"text":"browser, only when it"},
  {"id":"cap23","start":41.805,"duration":1.28,"text":"actually needs to,"},
  {"id":"cap24","start":43.085,"duration":1.68,"text":"with no manual configuration"},
  {"id":"cap25","start":44.765,"duration":1.68,"text":"deciding which path to take."},
  {"id":"cap26","start":46.73,"duration":1.6,"text":"The tell is simple. Point"},
  {"id":"cap27","start":48.33,"duration":1.68,"text":"it at a genuinely JavaScript"},
  {"id":"cap28","start":50.01,"duration":1.52,"text":"heavy page and see what"},
  {"id":"cap29","start":51.53,"duration":1.92,"text":"actually comes back. A real"},
  {"id":"cap30","start":53.45,"duration":1.68,"text":"answer or an empty shell."},
  {"id":"cap31","start":55.421,"duration":1.6,"text":"This is the category Crawl"},
  {"id":"cap32","start":57.021,"duration":2.0,"text":"API is built into automatic"},
  {"id":"cap33","start":59.021,"duration":4.0,"text":"three-tier escalation, respecting robots.txt"},
  {"id":"cap34","start":63.021,"duration":1.52,"text":"by default, with the same"},
  {"id":"cap35","start":64.541,"duration":1.84,"text":"key working for a REST call"},
  {"id":"cap36","start":66.381,"duration":2.08,"text":"or direct MCP access from"},
  {"id":"cap37","start":68.461,"duration":2.8,"text":"an agent. 100 free credits,"},
  {"id":"cap38","start":71.261,"duration":1.12,"text":"no card required."},
  {"id":"cap39","start":72.73,"duration":1.52,"text":"The real test of a scraping"},
  {"id":"cap40","start":74.25,"duration":1.52,"text":"tool was never the easy"},
  {"id":"cap41","start":75.77,"duration":1.68,"text":"page. It's always the one"},
  {"id":"cap42","start":77.45,"duration":0.8,"text":"that resists."},
  {"id":"cap43","start":78.541,"duration":1.28,"text":"Follow for more of this kind"},
  {"id":"cap44","start":79.821,"duration":0.72,"text":"of content."}
]
